{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ics24.ir/contracts/index_manifest.schema.json",
  "title": "IndexManifest",
  "type": "object",
  "required": ["manifest_id", "schema_version", "created_at", "packs", "corpus"],
  "properties": {
    "manifest_id": { "type": "string" },
    "schema_version": { "type": "string", "const": "index-manifest/v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "code_git_sha": { "type": "string" },
    "corpus": {
      "type": "object",
      "properties": {
        "dvc_rev": { "type": "string" },
        "source_dir": { "type": "string" },
        "doc_count": { "type": "integer" },
        "chunk_count": { "type": "integer" }
      }
    },
    "packs": {
      "type": "object",
      "properties": {
        "schemas": { "type": "string" },
        "taxonomy": { "type": "string" },
        "canned": { "type": "string" },
        "prompts_orchestrator": { "type": "string" },
        "retrieval": { "type": "string" }
      }
    },
    "embedding_model": { "type": "string" },
    "embedding_dim": { "type": "integer" },
    "active": { "type": "boolean" }
  }
}
