{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orchestrator Chat Completion Response",
  "type": "object",
  "required": ["id", "object", "model", "choices"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^chatcmpl-"
    },
    "object": {
      "type": "string",
      "const": "chat.completion"
    },
    "model": {"type": "string"},
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "message", "finish_reason"],
        "properties": {
          "index": {"type": "integer", "const": 0},
          "message": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": {"type": "string", "const": "assistant"},
              "content": {"type": "string"}
            }
          },
          "finish_reason": {
            "type": "string",
            "enum": ["stop", "length", "content_filter"]
          }
        }
      }
    },
    "usage": {
      "type": ["object", "null"],
      "properties": {
        "prompt_tokens": {"type": "integer"},
        "completion_tokens": {"type": "integer"},
        "total_tokens": {"type": "integer"}
      }
    },
    "rag": {
      "type": ["object", "null"],
      "properties": {
        "request_id": {"type": "string", "format": "uuid"},
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["chunk_id", "document_id", "title", "heading"],
            "properties": {
              "chunk_id": {"type": "string"},
              "document_id": {"type": "string"},
              "title": {"type": "string"},
              "heading": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}