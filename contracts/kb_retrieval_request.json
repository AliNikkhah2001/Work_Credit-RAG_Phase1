{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KB Retrieval Request",
  "type": "object",
  "required": ["query", "top_k"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "description": "Standalone user question"
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "description": "Number of results to return"
    }
  },
  "additionalProperties": false
}