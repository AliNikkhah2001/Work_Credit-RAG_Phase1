# Docker Compose Environment Variables
# Copy this file to .env and edit values. NEVER commit .env with real secrets.

# ============================================================
# Gemma Model (REQUIRED)
# ============================================================
# Host path to your Gemma GGUF file (must exist on host)
# Compose resolves relative to deploy/docker/ if not absolute
MODEL_FILE=/path/to/gemma-4-31B-it-UD-Q4_K_XL.gguf

# Alternative: use prebuilt llama-server binary instead of compiling
# LLAMA_SERVER_BIN=/path/to/llama-server

# ============================================================
# Database
# ============================================================
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=kb_manager
# Note: docker-compose.yml uses LANGFUSE_DB_PASSWORD for langfuse-db;
# LANGFUSE_DB_USER and LANGFUSE_DB_NAME are not referenced in docker-compose.yml.
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_NAME=langfuse

# ============================================================
# KB Manager
# ============================================================
KB_DB_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/kb_manager
KB_WEB_HOST=0.0.0.0
KB_WEB_PORT=8000
KB_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
KB_EMBED_DEVICE=cpu
KB_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
KB_RERANKER_DEVICE=cpu
KB_KEYWORD_BOOST=3.0

# ============================================================
# Guardrails
# ============================================================
GUARDRAILS_HOST=0.0.0.0
GUARDRAILS_PORT=8200
# Note: docker-compose.yml references LLM_MODEL and LLM_API_KEY (falling back to gemma / sk-local-dev).
UPSTREAM_LLM_BASE_URL=http://llama-server:18000/v1
UPSTREAM_LLM_MODEL=unsloth/gemma-4-31B-it-GGUF:UD-Q4_K_XL
UPSTREAM_LLM_API_KEY=sk-local-dev

# ============================================================
# Orchestrator
# ============================================================
KB_BASE_URL=http://kb:8000
GUARDRAILS_BASE_URL=http://guardrails:8200
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-mvp-local
LANGFUSE_SECRET_KEY=sk-lf-mvp-local
TRACE_ENABLED=true

# ============================================================
# Langfuse v2 (ghcr.io/langfuse/langfuse:2)
# ============================================================
# Note: docker-compose.yml references LANGFUSE_ADMIN_EMAIL / LANGFUSE_ADMIN_PASSWORD (instead of LANGFUSE_INIT_USER_*),
# uses LANGFUSE_SALT (instead of SALT), and maps LANGFUSE_INIT_PROJECT_* from LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
LANGFUSE_INIT_USER_EMAIL=admin@local.test
LANGFUSE_INIT_USER_PASSWORD=changeme
LANGFUSE_INIT_ORG_ID=org-seeded-001
LANGFUSE_INIT_PROJECT_ID=proj-seeded-001
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-seeded-public-001
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-seeded-secret-001
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-hex-32
SALT=changeme-generate-with-openssl-rand-hex-16
ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# ============================================================
# Open WebUI
# ============================================================
OPENAI_API_BASE_URL=http://orchestrator:8100/v1
OPENAI_API_KEY=sk-local-dev
WEBUI_AUTH=false
DATA_DIR=/app/backend/data

# ============================================================
# HF Cache (shared volume)
# ============================================================
HF_HOME=/models
HF_HUB_CACHE=/models
HF_HUB_OFFLINE=1

# ============================================================
# Gemma Server (llama.cpp)
# ============================================================
# Note: docker-compose.yml references CTX_SIZE and LLAMA_NGL (instead of LLAMA_CTX_SIZE and LLAMA_N_GPU_LAYERS).
LLAMA_CTX_SIZE=8192
LLAMA_TEMP=0.2
LLAMA_N_GPU_LAYERS=999
# Critical: --no-mmproj --jinja + enable_thinking:false prevents <unused*> leaks