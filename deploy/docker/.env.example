# Docker stack tunables. Copy to `.env` (same dir) and adjust — NEVER commit `.env`
# with real secrets. Every value below is a local-dev placeholder; change the
# Langfuse/DB passwords before any non-localhost deployment.

# --- LLM (llama-server + Gemma GGUF) ---
# Host path to the Gemma GGUF, bind-mounted read-only to /models/model.gguf
# inside llama-server. Example:
# MODEL_FILE=/models/gemma-4-31B-it-UD-Q4_K_XL.gguf
MODEL_FILE=./models/model.gguf
# In-container model path (change only if you remount elsewhere).
MODEL_PATH=/models/model.gguf
# Model id advertised to clients (must match start.sh / Vast convention).
LLM_MODEL=unsloth/gemma-4-31B-it-GGUF:UD-Q4_K_XL
LLM_API_KEY=sk-local-dev
LLM_BASE_URL=http://llama-server:18000/v1
# llama.cpp source ref (branch/tag) for the Dockerfile.llama builder stage.
LLAMA_REF=master
# Optional prebuilt llama-server binary (path INSIDE the repo = build context),
# e.g. LLAMA_SERVER_BIN=build/llama-server. Unset = compile from source.
#LLAMA_SERVER_BIN=build/llama-server
# Llama runtime: match start.sh (8192 ctx ≈ 22.7/24 GB VRAM on a 3090).
CTX_SIZE=8192
LLAMA_TEMP=0.2
LLAMA_NGL=999
# Extra llama-server flags, appended verbatim, e.g. "--mlock --cache-type-k q8_0".
#LLAMA_EXTRA_ARGS=

# --- Postgres (KB) ---
POSTGRES_PASSWORD=postgres

# --- KB ---
# 0 = allow first-run embedding-model download into the `models` volume (needs net).
# Set to 1 once the volume is warm (mirrors start.sh HF_HUB_OFFLINE=1).
HF_HUB_OFFLINE=0

# --- Langfuse v2 stack ---
LANGFUSE_DB_PASSWORD=postgres
CLICKHOUSE_PASSWORD=clickhouse
LANGFUSE_PUBLIC_KEY=pk-lf-docker-local
LANGFUSE_SECRET_KEY=sk-lf-docker-local
NEXTAUTH_SECRET=langfuse-secret-change-me-in-production
LANGFUSE_SALT=langfuse-salt-change-me-in-production
LANGFUSE_ADMIN_EMAIL=admin@work-rag.local
LANGFUSE_ADMIN_PASSWORD=admin123
# Orchestrator tracing target. Default = in-stack Langfuse; use
# http://tracing-fallback:3000 if the langfuse stack is stopped.
LANGFUSE_HOST=http://langfuse:3000
TRACE_ENABLED=true

# --- Orchestrator ---
REQUEST_TIMEOUT_SECONDS=120
RETRIEVAL_TOP_K=5

# --- WebUI (only service publishing a host port by default) ---
WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
WEBUI_PORT=13000
WEBUI_AUTH=false
OPENAI_API_KEY=sk-local-dev
