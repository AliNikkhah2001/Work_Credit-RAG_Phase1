# =============================================================================
# GPU / production environment (DANA_HOST=gpu, DANA_ROLE=prod)
# Self-hosted GPU server behind corporate Squid proxy:
#   http_proxy=http://192.168.203.2:3128  https_proxy=http://192.168.203.2:3128
# Localhost traffic MUST bypass the proxy (no_proxy / trust_env=False).
#
# Use with: docker compose -f deploy/compose/compose.base.yml \
#                  -f deploy/compose/compose.gpu.yml --env-file deploy/compose/env.gpu.example
# =============================================================================

# --- Host / role -------------------------------------------------------------
DANA_ENV=prod
DANA_HOST=gpu
DANA_ROLE=prod
DANA_HOST_REPO=/workspace/Work_Credit-RAG_Phase1

# --- Corporate Squid proxy (set in every shell on the GPU host) --------------
# http_proxy=http://192.168.203.2:3128
# https_proxy=http://192.168.203.2:3128
# no_proxy=localhost,127.0.0.1,.local
# NO_PROXY=localhost,127.0.0.1,.local

# --- LLM upstream (GPU is self-hosted only — NO OpenRouter on this host) -----
LLM_UPSTREAM_MODE=self_hosted
# Gemma via host llama-server :18000 OR via Manager :9000 (H200)
UPSTREAM_LLM_BASE_URL=http://127.0.0.1:18000/v1
UPSTREAM_LLM_MODEL=unsloth/gemma-4-31B-it-GGUF:UD-Q4_K_XL

# --- Database (system postgres + pgvector) -----------------------------------
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=kb_manager
KB_DB_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/kb_manager

# --- KB ----------------------------------------------------------------------
KB_WEB_HOST=0.0.0.0
KB_WEB_PORT=8000
KB_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
KB_EMBED_DEVICE=cuda
KB_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
KB_RERANKER_DEVICE=cuda

# --- Guardrails --------------------------------------------------------------
GUARDRAILS_HOST=0.0.0.0
GUARDRAILS_PORT=8200
UPSTREAM_LLM_BASE_URL=http://127.0.0.1:18000/v1
UPSTREAM_LLM_MODEL=unsloth/gemma-4-31B-it-GGUF:UD-Q4_K_XL

# --- Orchestrator ------------------------------------------------------------
KB_BASE_URL=http://127.0.0.1:8000
GUARDRAILS_BASE_URL=http://127.0.0.1:8200
LANGFUSE_HOST=http://127.0.0.1:3001
LANGFUSE_PUBLIC_KEY=pk-lf-prod-local
LANGFUSE_SECRET_KEY=sk-lf-prod-local
TRACE_ENABLED=true

# --- WebUI -------------------------------------------------------------------
OPENAI_API_BASE_URL=http://127.0.0.1:8100/v1
OPENAI_API_KEY=sk-local-dev
WEBUI_AUTH=false
WEBUI_NAME=Work RAG (production GPU)
WEBUI_BUILD_VERSION=0

# --- HF cache (self-hosted GPU) ----------------------------------------------
HF_HOME=/tmp/hf_clean
HF_HUB_CACHE=/tmp/hf_clean
HF_HUB_OFFLINE=1

# --- Proxy bypass for localhost (critical — Squid hangs otherwise) -----------
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# --- Middleware / gateway (chat.ics24.ir) ------------------------------------
# Traffic to chat.ics24.ir passes through a middleware gateway that forwards
# to this server's Open WebUI (port 13000). The middleware may cache static
# assets — bump WEBUI_BUILD_VERSION and run scripts/webui_cache_bust.sh after
# any WebUI/theme change to invalidate the cache.
WEBUI_PUBLIC_HOST=chat.ics24.ir
WEBUI_PORT=13000
