# =============================================================================
# Laptop / local development environment (DANA_HOST=laptop, DANA_ROLE=stage)
# Use with: docker compose -p dana-local -f deploy/compose/compose.base.yml \
#                  -f deploy/compose/compose.local.yml --env-file deploy/compose/env.laptop.example
#
# NOTE: this file is a TEMPLATE. The live dev stack reads deploy/compose/.env.
# Keep the two in sync when you add a key.
# =============================================================================

# --- Host / role -------------------------------------------------------------
# COMPOSE_PROJECT_NAME would otherwise be inferred from the directory name; a run
# without `-p` would then create a differently named stack than dana-local.
COMPOSE_PROJECT_NAME=dana-local
DANA_ENV=test
DANA_HOST=laptop
DANA_ROLE=stage

# --- LLM upstream (laptop uses OpenRouter via LiteLLM) -----------------------
LLM_UPSTREAM_MODE=openrouter
UPSTREAM_LLM_BASE_URL=http://litellm:4000/v1
# MUST be a `model_name` from deploy/compose/litellm.local.yaml (chat-primary,
# gemma-4-31b, openrouter-chat). The literal OpenRouter id
# `google/gemma-4-31b-it` is REJECTED by LiteLLM with HTTP 400 "Invalid model
# name" — LiteLLM routes by alias, not by upstream id.
UPSTREAM_LLM_MODEL=chat-primary
OPENROUTER_MODEL=openrouter/google/gemma-4-31b-it
OPENROUTER_API_KEY=sk-or-...
LITELLM_MASTER_KEY=sk-local-dev
LLM_API_KEY=sk-local-dev

# --- Database (laptop compose postgres) --------------------------------------
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=kb_manager
# KB_DB_URL is what the KB actually reads. Setting only KB_DB_HOST/PORT/NAME
# makes the KB silently use SQLite. Not a compose key — kept for host tooling.
KB_DB_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/kb_manager

# --- KB ----------------------------------------------------------------------
KB_WEB_HOST=0.0.0.0
KB_WEB_PORT=8000
# Local 384-d embed must match the existing pgvector index. Switching to
# OpenRouter embed (1536-d) requires a rebuilt image AND a full re-ingest.
KB_EMBED_BACKEND=local
KB_RERANKER_BACKEND=openrouter
KB_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KB_EMBED_DIM=384
KB_RERANKER_MODEL=cohere/rerank-v3.5
KB_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KB_EMBED_DEVICE=cpu
KB_RERANKER_DEVICE=cpu
KB_USE_TANTIVY=false

# --- Guardrails --------------------------------------------------------------
GUARDRAILS_HOST=0.0.0.0
GUARDRAILS_PORT=8200

# --- Orchestrator ------------------------------------------------------------
KB_BASE_URL=http://kb:8000
GUARDRAILS_BASE_URL=http://guardrails:8200
REQUEST_TIMEOUT_SECONDS=120
RETRIEVAL_TOP_K=5
LANGFUSE_HOST=http://tracing:3000
LANGFUSE_PUBLIC_KEY=pk-lf-mvp-local
LANGFUSE_SECRET_KEY=sk-lf-mvp-local
# Tracing is off by default on the laptop: the fallback collector (:13002) is
# optional and a dead LANGFUSE_HOST otherwise adds latency to every turn.
TRACE_ENABLED=false

# --- WebUI -------------------------------------------------------------------
OPENAI_API_BASE_URL=http://orchestrator:8100/v1
OPENAI_API_KEY=sk-local-dev
WEBUI_AUTH=false
WEBUI_NAME=Work RAG (laptop stage)
# Bumped by scripts/webui_cache_bust.sh. Reaches the image only through
# --build-arg BUILD_HASH, so bumping it alone does NOT refresh the container.
WEBUI_BUILD_VERSION=0

# --- HF cache (CPU, laptop) --------------------------------------------------
HF_HOME=/tmp/hf_clean
HF_HUB_CACHE=/tmp/hf_clean
HF_HUB_OFFLINE=1

# --- Jenkins (laptop controller) ---------------------------------------------
DANA_HOST_REPO=/Users/alinikkhah/Documents/Work/CreditScoring/Chatbot_production_v1
