# =============================================================================
# Laptop / local development environment (DANA_HOST=laptop, DANA_ROLE=stage)
# Use with: docker compose -f deploy/compose/compose.base.yml \
#                  -f deploy/compose/compose.local.yml --env-file deploy/compose/env.laptop.example
# =============================================================================

# --- Host / role -------------------------------------------------------------
DANA_ENV=test
DANA_HOST=laptop
DANA_ROLE=stage

# --- LLM upstream (laptop uses OpenRouter via LiteLLM) -----------------------
LLM_UPSTREAM_MODE=openrouter
UPSTREAM_LLM_BASE_URL=http://litellm:4000/v1
UPSTREAM_LLM_MODEL=google/gemma-4-31b-it
OPENROUTER_API_KEY=sk-or-...   # set your OpenRouter key here
LITELLM_MASTER_KEY=sk-local-dev

# --- Database (laptop compose postgres) --------------------------------------
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=kb_manager
KB_DB_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/kb_manager

# --- KB ----------------------------------------------------------------------
KB_WEB_HOST=0.0.0.0
KB_WEB_PORT=8000
KB_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
KB_EMBED_DEVICE=cpu
KB_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
KB_RERANKER_DEVICE=cpu

# --- Guardrails --------------------------------------------------------------
GUARDRAILS_HOST=0.0.0.0
GUARDRAILS_PORT=8200
UPSTREAM_LLM_BASE_URL=http://litellm:4000/v1
UPSTREAM_LLM_MODEL=google/gemma-4-31b-it

# --- Orchestrator ------------------------------------------------------------
KB_BASE_URL=http://kb:8000
GUARDRAILS_BASE_URL=http://guardrails:8200
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-mvp-local
LANGFUSE_SECRET_KEY=sk-lf-mvp-local
TRACE_ENABLED=true

# --- WebUI -------------------------------------------------------------------
OPENAI_API_BASE_URL=http://orchestrator:8100/v1
OPENAI_API_KEY=sk-local-dev
WEBUI_AUTH=false
WEBUI_NAME=Work RAG (laptop stage)
WEBUI_BUILD_VERSION=0

# --- HF cache (CPU, laptop) --------------------------------------------------
HF_HOME=/tmp/hf_clean
HF_HUB_CACHE=/tmp/hf_clean
HF_HUB_OFFLINE=1

# --- Jenkins (laptop controller) ---------------------------------------------
DANA_HOST_REPO=/Users/alinikkhah/Documents/Work/CreditScoring/Chatbot_production_v1
