# Copy to deploy/compose/.env (gitignored). Never commit real keys.
COMPOSE_PROJECT_NAME=dana-local

# Runtime selector — controls LLM upstream for app + which compose overlay to use.
#   test  + openrouter  → laptop: LiteLLM → OpenRouter (no local Gemma/GPU)
#   prod  + self_hosted → GPU server: Gemma/Manager/TRT (no OpenRouter)
DANA_ENV=test
LLM_UPSTREAM_MODE=openrouter

# LiteLLM / OpenRouter (only used when LLM_UPSTREAM_MODE=openrouter)
LITELLM_MASTER_KEY=sk-litellm-local-dev-change-me
OPENROUTER_API_KEY=
# Closest public match to self-hosted Gemma 4 31B IT
OPENROUTER_MODEL=openrouter/google/gemma-4-31b-it
UPSTREAM_LLM_MODEL=chat-primary
LLM_API_KEY=sk-litellm-local-dev-change-me
UPSTREAM_LLM_BASE_URL=http://litellm:4000/v1

# Shared
POSTGRES_PASSWORD=postgres
REQUEST_TIMEOUT_SECONDS=120
RETRIEVAL_TOP_K=5
HF_HUB_OFFLINE=0

# Retrieval backends (laptop defaults match the usual 384-d MiniLM pgvector index).
# Only switch to OpenRouter embed/rerank after:
#   1) rebuilding rag-kb:local with current kb-manager sources, and
#   2) re-ingesting so chunk embeddings are 1536-d.
# Mixing OpenRouter 1536-d queries with a 384-d index (or an old image missing
# OpenRouterEmbedder) will break search; compose recreate alone does not rebuild the image.
KB_EMBED_BACKEND=local
KB_RERANKER_BACKEND=openrouter
KB_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KB_EMBED_DIM=384
KB_RERANKER_MODEL=cohere/rerank-v3.5
# OpenRouter embed path (optional, after re-ingest — do not mix with 384-d rows):
# KB_EMBED_BACKEND=openrouter
# KB_RERANKER_BACKEND=openrouter
# KB_EMBED_MODEL=openai/text-embedding-3-small
# KB_EMBED_DIM=1536
# KB_RERANKER_MODEL=cohere/rerank-v3.5
KB_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KB_EMBED_DEVICE=cpu
KB_RERANKER_DEVICE=cpu
KB_USE_TANTIVY=false

# Tracing (optional). TRACE_ENABLED=false keeps the fallback collector out of the
# request path; set it to true only when LANGFUSE_HOST is actually reachable.
TRACE_ENABLED=false
LANGFUSE_HOST=http://tracing:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# WebUI cache-bust token. Bumping this alone does NOT rebuild the image — the
# value reaches the image only through --build-arg BUILD_HASH (see
# scripts/webui_cache_bust.sh).
WEBUI_BUILD_VERSION=0
