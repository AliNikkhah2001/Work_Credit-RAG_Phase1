# Copy to deploy/compose/.env (gitignored). Never commit real keys.
COMPOSE_PROJECT_NAME=dana-local

# Runtime selector — controls LLM upstream for app + which compose overlay to use.
#   test  + openrouter  → laptop: LiteLLM → OpenRouter (no local Gemma/GPU)
#   prod  + self_hosted → GPU server: Gemma/Manager/TRT (no OpenRouter)
DANA_ENV=test
LLM_UPSTREAM_MODE=openrouter

# LiteLLM / OpenRouter (only used when LLM_UPSTREAM_MODE=openrouter)
LITELLM_MASTER_KEY=sk-litellm-local-dev-change-me
OPENROUTER_API_KEY=
# Closest public match to self-hosted Gemma 4 31B IT
OPENROUTER_MODEL=openrouter/google/gemma-4-31b-it
UPSTREAM_LLM_MODEL=chat-primary
LLM_API_KEY=sk-litellm-local-dev-change-me
UPSTREAM_LLM_BASE_URL=http://litellm:4000/v1

# Shared
POSTGRES_PASSWORD=postgres
REQUEST_TIMEOUT_SECONDS=120
RETRIEVAL_TOP_K=5
HF_HUB_OFFLINE=0

# Retrieval backends (laptop): call OpenRouter instead of serving MiniLM / BGE locally.
# GPU/self-hosted: leave backends as local and set devices to cuda via compose.gpu.yml.
KB_EMBED_BACKEND=openrouter
KB_RERANKER_BACKEND=openrouter
KB_EMBED_MODEL=openai/text-embedding-3-small
KB_EMBED_DIM=1536
KB_RERANKER_MODEL=cohere/rerank-v3.5
KB_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KB_EMBED_DEVICE=cpu
KB_RERANKER_DEVICE=cpu
KB_USE_TANTIVY=false
