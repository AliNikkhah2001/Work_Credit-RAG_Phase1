# Iranian / regional package mirrors (public HTTPS, no auth).
# Sourced by scripts/ci_apply_iran_mirrors.sh for GPU/prod CI fallbacks.
# Official registries remain in EXTRA / tail of the chain when possible.
#
# Probed reachable (2026-11-15, from laptop): shecan, runflare, liara (200).
# Kargadan npm/pypi paths were flaky (404/timeout) — kept as optional extras.

# --- PyPI (pip / uv) ---
IRAN_PIP_INDEX_URL=https://mirror-pypi.pkg.shecan.ir/simple/
IRAN_PIP_EXTRA_INDEX_URL="https://mirror-pypi.runflare.com/simple/ https://package-mirror.liara.ir/repository/pypi/simple/ https://pypi.org/simple"

# --- npm ---
IRAN_NPM_REGISTRY=https://mirror-npm.pkg.shecan.ir/
IRAN_NPM_REGISTRY_FALLBACK=https://mirror-npm.runflare.com/

# --- Docker Hub registry-mirrors (daemon.json on the GPU host; not applied by CI alone) ---
# https://docker.arvancloud.ir
# https://focker.ir
# https://docker-mirror.kargadan.ir
# https://mirror-docker.pkg.shecan.ir

# --- apt (Ubuntu) — host-level, optional ---
# https://mirror.arvancloud.ir/ubuntu
# http://ir.archive.ubuntu.com/ubuntu
