# Iranian / regional package mirrors — FALLBACKS ONLY (never primary).
# Official upstream stays first; these are extras / retry targets.
# Sourced by scripts/ci_apply_iran_mirrors.sh (laptop + GPU/prod).
#
# Probed reachable (2026-11-15): shecan, runflare, liara (200).
# Kargadan npm/pypi paths were flaky (404/timeout) — optional last resorts.

# --- PyPI (pip / uv): upstream primary is always pypi.org ---
# Applied only via PIP_EXTRA_INDEX_URL / UV_EXTRA_INDEX_URL.
IRAN_PIP_EXTRA_INDEX_URL="https://mirror-pypi.pkg.shecan.ir/simple/ https://mirror-pypi.runflare.com/simple/ https://package-mirror.liara.ir/repository/pypi/simple/"

# --- npm: upstream primary is always registry.npmjs.org ---
# Used only when npm ci/install against upstream fails (retry loop).
IRAN_NPM_REGISTRIES="https://mirror-npm.pkg.shecan.ir/ https://mirror-npm.runflare.com/ https://package-mirror.liara.ir/repository/npm/"

# --- Docker Hub ---
# daemon.json registry-mirrors are tried BEFORE docker.io by Docker Engine.
# Do NOT install by default if you need Hub-first; keep file opt-in for
# Hub-blocked hosts only (see deploy/mirrors/docker-daemon-registry-mirrors.json).
# Prefixed pull fallbacks (manual / scripts): arvan, focker, shecan, kargadan, liara.

# --- apt (Ubuntu) — host-level, optional (replaces archive — not a soft fallback) ---
# https://mirror.arvancloud.ir/ubuntu
# http://ir.archive.ubuntu.com/ubuntu
